#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APP_ICON ICON "voice_app_logo.ico"
IDI_RECORDING_ICON ICON "voice_app_logo_recording.ico"

// Version info
VS_VERSION_INFO VERSIONINFO
FILEVERSION     VTT_VERSION_NUMBERS
PRODUCTVERSION  VTT_VERSION_NUMBERS
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "VoiceToText"
            VALUE "FileDescription",  "Voice to Text - Local Speech Recognition"
            VALUE "FileVersion",      VTT_VERSION_STRING
            VALUE "InternalName",     "VoiceToText"
            VALUE "OriginalFilename", "VoiceToText.exe"
            VALUE "ProductName",      "VoiceToText"
            VALUE "ProductVersion",   VTT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
